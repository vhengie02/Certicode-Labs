{
  "name": "certicode-labs",
  "displayName": "CertiCode Labs IDE",
  "description": "Integrate your CertiCode Labs Java sessions directly into VS Code.",
  "version": "1.7.0",
  "publisher": "certicode",
  "repository": {
    "type": "git",
    "url": "https://github.com/vhengie02/Certicode-Labs.git"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "certicode-explorer",
          "title": "CertiCode Labs",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "certicode-explorer": [
        {
          "type": "webview",
          "id": "certicode-labs.sidebar",
          "name": "Lab Control Center"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package",
    "distribute": "npx @vscode/vsce package -o ../public/downloads/certicode-labs.vsix",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5"
  }
}
